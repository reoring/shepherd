{
  "name": "sheperd",
  "version": "0.1.0",
  "private": true,
  "description": "Independent evidence-bound recursive agent runtime for Pi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reoring/sheperd.git"
  },
  "homepage": "https://github.com/reoring/sheperd#readme",
  "bugs": {
    "url": "https://github.com/reoring/sheperd/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "pi": {
    "extensions": ["./src/native-extension.ts"],
    "skills": ["./skills"]
  },
  "bin": {
    "sheperd": "src/sheperd-cli.ts"
  },
  "scripts": {
    "benchmark:v3": "node src/benchmark-v3.ts",
    "benchmark:matched-patch": "node src/matched-patch-benchmark-cli.ts",
    "check:contract": "node src/sheperd-cli.ts check",
    "query": "node src/sheperd-cli.ts query",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
